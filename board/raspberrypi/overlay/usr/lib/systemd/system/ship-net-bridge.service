[Unit]
Description=ship network bridge
Wants=ship-control.service ship-nav.service wpa_supplicant.service
After=ship-control.service ship-nav.service wpa_supplicant.service

[Service]
Type=exec
ExecStart=/bin/ship-net-bridge
ExecStop=/bin/killall ship-net-bridge
Restart=on-failure
RestartSec=3
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=ship-net-bridge

[Install]
WantedBy=multi-user.target
